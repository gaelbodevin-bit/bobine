rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur ne voit et ne modifie que ses propres données.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Droit Premium : lisible par son propriétaire, écrit uniquement par les Cloud Functions.
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Registre des achats : serveur uniquement.
    match /purchases/{id} {
      allow read, write: if false;
    }
  }
}
