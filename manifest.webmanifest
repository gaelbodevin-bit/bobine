{
  "name": "Playwatch — séries, films & jeux",
  "short_name": "Playwatch",
  "description": "Suis tes séries, films et jeux vidéo : épisodes vus, prochaines sorties, notifications.",
  "lang": "fr",
  "start_url": "./#series",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0d0d11",
  "theme_color": "#0d0d11",
